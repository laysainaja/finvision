{
  "name": "finvision",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.js",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js --prod",
    "typecheck": "tsc --noEmit",
    "db:setup": "node --env-file-if-exists=.env scripts/db-setup.js",
    "db:seed": "node --env-file-if-exists=.env scripts/seed-demo.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "express": "^5.3.0",
    "jose": "^6.2.12",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}

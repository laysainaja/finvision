# Copie este arquivo para ".env" e preencha com os dados do seu projeto no Supabase.
# O .env NUNCA vai para o GitHub (está no .gitignore). Na Vercel, cadastre as mesmas variáveis em Settings → Environment Variables.

# Supabase → botão "Connect" → aba "ORMs" ou "Connection String" → "Transaction pooler" (porta 6543).
# Troque [YOUR-PASSWORD] pela senha do banco definida ao criar o projeto.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Supabase → Project Settings → API (ou "Data API").
# A chave "anon"/"publishable" é pública por natureza (vai para o navegador); NÃO use a "service_role"/"secret".
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=cole-aqui-a-chave-anon-ou-publishable
